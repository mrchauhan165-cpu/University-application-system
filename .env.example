# ---------------------------------------------------------------- environment
# Copy this file to `.env.local` for local builds. NOTHING here is a secret:
# only the publishable/anon key may ever be used in a browser bundle.
#
# The demo build needs none of these values — it runs entirely in the browser.

# Base path for static hosting.
#   GitHub Pages project site -> /<repository>/
#   User site, Netlify, S3, nginx, custom domain -> /
VITE_BASE_PATH=/

# --------------------------------------------------- Supabase (public values)
# Fill these in to let the build talk to the project. They are *publishable*
# values that are safe to ship in a static bundle, and the portal only uses them
# for the connection check today (see docs/SUPABASE-INTEGRATION-PLAN.md).
# The live Pages site gets them from repository Variables, not from this file.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-PUBLISHABLE-ANON-KEY

# NEVER put any of the following in this file or anywhere in the repository:
#   - service_role key
#   - database password / connection string
#   - SMTP or email provider credentials
#   - JWT signing secret
# They belong only in the hosting provider's encrypted secret store.
